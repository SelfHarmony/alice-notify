# Скопируйте в .env и заполните. Файл .env в .gitignore — не коммитить.

# --- Неофициальный quasar API ---
# Долгоживущий x-token Яндекса. Получить: python scripts/get_token.py (вход по QR, без пароля).
YANDEX_X_TOKEN=

# База неофициального API (обычно менять не нужно)
QUASAR_BASE_URL=https://iot.quasar.yandex.ru/m

# id станции/колонки. Подскажет python scripts/discover.py — впишите сюда.
STATION_DEVICE_ID=

# --- FastAPI ---
# Bearer-токен для защиты REST API (придумайте длинную случайную строку)
API_AUTH_TOKEN=

# --- Удалённый MCP-сервер (mcp_remote) ---
# Общий пароль: все клиенты шлют Authorization: Bearer <MCP_AUTH_TOKEN>. Обязателен для mcp_remote.
MCP_AUTH_TOKEN=
# Хост/порт/путь HTTP-сервера (значения по умолчанию задаются в docker-compose)
MCP_HOST=0.0.0.0
MCP_PORT=8848
MCP_PATH=/mcp

# --- Тюнинг ---
# Сколько секунд ждать ответ API
REPLY_TIMEOUT_SECONDS=20
# Макс. длина одного TTS-чанка (лимит Яндекса 100; берётся с запасом)
TTS_CHUNK_SIZE=90
